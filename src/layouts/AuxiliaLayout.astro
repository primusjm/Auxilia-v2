---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/auxilia/tokens.css';
import '../styles/auxilia/base.css';
import '../styles/auxilia/chrome.css';
import '../styles/auxilia/states.css';
import '../styles/a11y.css';
import '../styles/interactive.css';
import Loader from '../components/Loader.astro';
import SiteMenu from '../components/SiteMenu.astro';
import ContactSection from '../components/ContactSection.astro';
import ContactModal from '../components/ContactModal.astro';
import Lightbox from '../components/Lightbox.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';

interface MenuItem {
  label: string;
  sub: string;
  href: string;
  icon: string[];
  tab?: number;
}
interface Props {
  title: string;
  description: string;
  /** Path of the social image, from the site root. */
  ogImage?: string;
  screenLabel?: string;
  menu: MenuItem[];
  /** Subject line sent with the contact form. */
  formSubject?: string;
  lightbox?: boolean;
}
const { title, description, ogImage = '/assets/og.png', screenLabel, menu, formSubject = 'Book a call', lightbox = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Auxilia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('auxilia-theme-v2'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
        // Accessibility preferences, shared by both sites (see src/scripts/a11y.ts).
        var p = {};
        try { p = JSON.parse(localStorage.getItem('auxilia-a11y-v1') || '{}') || {}; } catch (e) {}
        var c = document.documentElement.classList;
        if (p.size === 1 || p.size === 2) c.add('a11y-size-' + p.size);
        if (p.font === 'plain' || p.font === 'dyslexic') c.add('a11y-font-' + p.font);
        ['contrast', 'links', 'nobold', 'spacing', 'motion'].forEach(function (k) { if (p[k]) c.add('a11y-' + k); });
      })();
    </script>
    <slot name="head" />
  </head>
  <body style="margin:0;">
    <div data-screen-label={screenLabel} style="min-height:100vh;background:var(--paper);color:var(--ink);overflow-x:clip;position:relative;isolation:isolate;">
      <Loader />
      <SiteMenu items={menu} />
      <slot />
      <ContactSection />
      <ContactModal subject={formSubject} />
      {lightbox && <Lightbox />}
      <PrivacyNotice form />
    </div>
    <script>
      import '../scripts/chrome';
      import '../scripts/a11y';
      import '../scripts/icons-once';
    </script>
  </body>
</html>
