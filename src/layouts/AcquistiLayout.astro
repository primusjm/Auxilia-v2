---
import '../styles/fonts.css';
import '../styles/acquisti/base.css';
import '../styles/acquisti/states.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage = '/acquisti/assets/acquisti/icon.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/acquisti/assets/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Acquisti" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('acquisti-theme-v1'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body style="margin:0;">
    <slot />
    <script>
      import '../scripts/nav';
      import '../scripts/acquisti-footer';
    </script>
  </body>
</html>
