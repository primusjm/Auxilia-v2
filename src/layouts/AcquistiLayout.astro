---
import '../styles/fonts.css';
import '../styles/acquisti/base.css';
import '../styles/acquisti/states.css';
import '../styles/a11y.css';
import '../styles/interactive.css';
import PrivacyNotice from '../components/PrivacyNotice.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage = '/acquisti/assets/acquisti/icon.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/acquisti/assets/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Acquisti" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('acquisti-theme-v1'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
        // Accessibility preferences, shared by both sites (see src/scripts/a11y.ts).
        var p = {};
        try { p = JSON.parse(localStorage.getItem('auxilia-a11y-v1') || '{}') || {}; } catch (e) {}
        var c = document.documentElement.classList;
        if (p.size === 1 || p.size === 2) c.add('a11y-size-' + p.size);
        if (p.font === 'plain' || p.font === 'dyslexic') c.add('a11y-font-' + p.font);
        ['contrast', 'links', 'nobold', 'spacing', 'motion'].forEach(function (k) { if (p[k]) c.add('a11y-' + k); });
      })();
    </script>
  </head>
  <body style="margin:0;">
    <slot />
    <PrivacyNotice policy="/acquisti/privacy" />
    <script>
      import '../scripts/nav';
      import '../scripts/acquisti-footer';
      import '../scripts/a11y';
      import '../scripts/icons-once';
    </script>
  </body>
</html>
