---
import { getCollection } from 'astro:content';
import AuxiliaLayout from '../../layouts/AuxiliaLayout.astro';
import { siteMenu } from '../../data/menu';
import RecordStudy from '../../components/work/RecordStudy.astro';
import '../../styles/auxilia/cs.css';
import '../../styles/auxilia/record.css';
import { plain } from '../../lib/rich';

export async function getStaticPaths() {
  const records = (await getCollection('work')).filter((e) => e.data.kind === 'record').sort((a, b) => a.data.order - b.data.order);
  return records.map((entry) => {
    // Related cards are the previous and next records; the first and last borrow from the other side.
    const i = records.findIndex((r) => r.id === entry.id);
    let idx = [i - 1, i + 1];
    if (i === 0) idx = [1, 2];
    if (i === records.length - 1) idx = [i - 2, i - 1];
    const related = idx.map((k) => {
      const r = records[k];
      return { slug: r.id, no: String(r.data.order).padStart(2, '0'), client: r.data.client, title: r.data.title, image: r.data.cardImage };
    });
    return { params: { slug: entry.id }, props: { entry, related } };
  });
}

const { entry, related } = Astro.props;
const d = entry.data as Extract<typeof entry.data, { kind: 'record' }>;
const menu = siteMenu(false);
const title = `${d.client}: ${d.title} | Auxilia`;
const description = plain(d.hero.lead);
---
<AuxiliaLayout
  title={title}
  description={description}
  ogImage={d.cardImage}
  screenLabel={`Case study ${String(d.order).padStart(3, '0')}: ${d.client}`}
  menu={menu}
  formSubject={d.formSubject}
  lightbox
>
  <RecordStudy study={d} related={related} slot="default" />
</AuxiliaLayout>
