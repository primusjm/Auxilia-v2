---
import { getCollection, getEntry } from 'astro:content';
import AuxiliaLayout from '../layouts/AuxiliaLayout.astro';
import HomeHead from '../components/home/HomeHead.astro';
import Marquee from '../components/home/Marquee.astro';
import Icon from '../components/Icon.astro';
import { rich, plain } from '../lib/rich';
import { ico } from '../lib/ico';
import '../styles/auxilia/home.css';
import '../styles/auxilia/home-extra.css';

const home = (await getEntry('pages', 'home'))!.data;
const records = (await getCollection('work'))
  .filter((e) => e.data.kind === 'record')
  .sort((a, b) => a.data.order - b.data.order);
const words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen', 'Twenty'];
const count = records.length;
const missions = words[count] ?? String(count);
const fill = (s: string) => s.replace('{missions}', missions).replace('{count}', String(count));
const pad = (n: number) => String(n).padStart(2, '0');

const spot = records.map((r) => ({
  slug: r.id,
  no: pad(r.data.order),
  client: r.data.client,
  year: r.data.year,
  sector: r.data.sector,
  title: r.data.title,
  stat: r.data.stat,
  statLabel: r.data.statLabel,
  image: r.data.cardImage,
  href: `/work/${r.id}`,
}));
const slides = home.hero.slides.map((slug: string) => spot.find((s) => s.slug === slug)!).filter(Boolean);

const menu = [
  { label: 'Record', sub: 'Our missions', href: '#record', icon: ['M3 6h7l2 2h9v11H3Z'] },
  { label: 'Constraints', sub: 'What we plan around', href: '#constraints', icon: ['M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18Z', 'M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10Z', 'M12 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2Z'] },
  { label: 'Capability', sub: 'What we build', href: '#capability', icon: ['m12 3 9 5-9 5-9-5Z', 'm3 13 9 5 9-5'] },
  { label: 'Method', sub: 'How we work', href: '#method', icon: ['M4 6h10', 'M4 12h16', 'M4 18h7'] },
  { label: 'Contact', sub: 'Say hello', href: '#contact', icon: ['M3 5h18v14H3Z', 'm3 7 9 6 9-6'] },
];

const wrap = 'max-width:1240px;margin:0 auto;padding:clamp(36px,4.5vw,60px) clamp(20px,4vw,44px);';
const first = slides[0];
const title = 'Auxilia: websites and tools for East Africa’s NGOs, foundations and funds';
const description = plain(fill(home.hero.lead));
---
<AuxiliaLayout title={title} description={description} screenLabel="Homepage (Ledger)" menu={menu} formSubject="Book a call">
  <main id="top" data-home="">
    <div aria-hidden="true" data-mark-top="" style="position:absolute;left:-90px;top:-150px;width:347px;height:600px;pointer-events:none;z-index:0;opacity:.07;transform-origin:50% 70%;transition:transform .8s cubic-bezier(.2,.7,.2,1);"><div style="position:absolute;inset:0;background:var(--brand);-webkit-mask:url(/assets/mark-helmet.png) center/contain no-repeat;mask:url(/assets/mark-helmet.png) center/contain no-repeat;"></div><div style="position:absolute;inset:0;background:var(--brand);-webkit-mask:url(/assets/mark-plume.png) center/contain no-repeat;mask:url(/assets/mark-plume.png) center/contain no-repeat;"></div></div>
    <a href="/" aria-label="Auxilia home" style="position:absolute;z-index:3;top:28px;left:clamp(20px,4vw,44px);display:inline-flex;align-items:center;text-decoration:none;"><Icon k="icaa80bf" data-ax-logo="" viewBox="140 60 4290 1410" width="132" height="43" aria-hidden="true" style="display:block;overflow:visible;" /></a>

    <section data-bubbles="">
      <div data-hero="" style="max-width:1240px;margin:0 auto;padding:calc(clamp(40px,6vw,72px) + 96px) clamp(20px,4vw,44px) clamp(44px,5.5vw,72px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(36px,5vw,64px);align-items:stretch;">
        <div style="display:flex;flex-direction:column;justify-content:flex-start;gap:clamp(22px,2.6vw,30px);">
          <div>
            <h1 data-reveal="" style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(44px,6.2vw,80px);line-height:1;letter-spacing:-0.025em;color:var(--ink);max-width:15ch;" set:html={rich(home.hero.title, 'h2')} />
          </div>
          <div data-reveal="" style="display:flex;flex-direction:column;gap:28px;">
            <p style="margin:0;font-size:clamp(16.5px,1.9vw,18px);line-height:1.62;color:var(--ink-soft);max-width:50ch;" set:html={rich(fill(home.hero.lead))} />
            <div data-hero-ctas="" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
              <a class="ax-fx" href="#contact" data-cta="" data-book="" style="display:inline-flex;align-items:center;gap:10px;height:54px;padding:0 26px;background:#3B28FF;color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:600;font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;white-space:nowrap;text-decoration:none;"><span data-draw-ico="" style="display:inline-flex;"><Icon k="ic8e21c5" {...ico(16, 1.8)} /></span>{home.hero.primaryCta}</a>
              <a class="ax-fx ax-fx-out" data-cta-down="" href="#record" style="display:inline-flex;align-items:center;gap:10px;height:54px;padding:0 22px;border:1px solid var(--rule-strong);color:var(--ink);font-family:'Outfit',sans-serif;font-weight:600;font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;white-space:nowrap;text-decoration:none;"><Icon k="ic0c3d48" {...ico(16, 1.8)} />{home.hero.secondaryCta}</a>
            </div>
          </div>
        </div>
        <div data-reveal="" data-hero-proof="" style="display:flex;flex-direction:column;border-top:2px solid var(--rule-strong);">
          <div data-hero-img="" style="position:relative;flex:1 1 0;min-height:140px;margin-top:18px;border:1px solid var(--rule);background:var(--surface);overflow:hidden;">
            {slides.map((p: any, i: number) => (
              <div class={'ax-hstage' + (i === 0 ? ' is-on' : '')} data-hslide={i}><img src={p.image} alt={p.client} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div>
            ))}
            <span data-h-label="" style="position:absolute;top:14px;left:14px;padding:6px 10px;background:#3B28FF;color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;pointer-events:none;">{first.client} · {first.year}</span>
          </div>
          <div style="display:flex;justify-content:space-between;gap:16px;align-items:end;padding:20px 0 16px;">
            <div style="flex:1 1 auto;min-width:0;"><div data-h-stat="" style="font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(40px,4.6vw,64px);line-height:.95;letter-spacing:-0.04em;color:var(--brand);white-space:nowrap;">{first.stat}</div><div data-h-stat-label="" style="margin-top:8px;font-size:14px;line-height:1.4;color:var(--ink-soft);max-width:30ch;">{first.statLabel}</div></div>
            <a class="ax-fx ax-fx-out" data-h-link="" href={first.href} target="_self" style="flex:none;justify-content:center;width:auto;box-sizing:border-box;display:inline-flex;align-items:center;gap:10px;height:44px;padding:0 16px;border:1px solid var(--rule-strong);color:var(--ink);font-family:'Outfit',sans-serif;font-weight:600;font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;white-space:nowrap;text-decoration:none;transition:background .3s ease,color .3s ease,border-color .3s ease;">{home.hero.caseStudyLabel}<Icon k="ic113c36" {...ico(15, 1.7)} /></a>
          </div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;">
            {slides.map((p: any, i: number) => (
              <button type="button" data-hseg={i} aria-label={p.client} style="height:16px;padding:6px 0;border:0;background:transparent;cursor:pointer;"><span style="display:block;position:relative;height:3px;background:var(--rule);overflow:hidden;"></span></button>
            ))}
          </div>
          <script type="application/json" id="hero-slides" set:html={JSON.stringify(slides.map((p: any) => ({ client: p.client, year: p.year, stat: p.stat, statLabel: p.statLabel, href: p.href })))} />
        </div>
      </div>
    </section>

    <Marquee words={home.marquee.topics} />

    <section style="border-bottom:1px solid var(--rule);background:var(--surface);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div data-stats="" style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,44px);display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
        {home.stats.map((s: any, i: number) => (
          <div data-reveal="" style={`padding:clamp(24px,3vw,34px) clamp(16px,2vw,28px);${i < home.stats.length - 1 ? 'border-right:1px solid var(--rule);' : ''}display:flex;flex-direction:column;align-items:center;text-align:center;`}>
            <span data-stat-ico="" aria-hidden="true" style="display:inline-flex;color:var(--brand);margin-bottom:14px;"><Icon k={s.icon} {...ico(22, 1.6)} /></span>
            <div data-count={s.value} data-pre={s.prefix || undefined} data-suf={s.suffix || undefined} style="font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(36px,4.4vw,50px);line-height:1;color:var(--ink);font-variant-numeric:tabular-nums;">{s.prefix}{s.value}{s.suffix}</div>
            <div style="margin-top:8px;font-family:'Outfit',sans-serif;font-weight:500;font-size:11px;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-soft);">{s.label}</div><a href="#record" style="margin-top:10px;font-size:13.5px;line-height:1.35;font-weight:500;color:var(--brand);text-decoration:none;" class="ax-h9bcc06">{s.client}</a>
          </div>
        ))}
      </div>
    </section>

    <section id="record">
      <div data-grid="" aria-hidden="true"></div>
      <div style="max-width:1240px;margin:0 auto;padding:clamp(36px,4.5vw,60px) clamp(20px,4vw,44px) 0;">
        <HomeHead no="01" tab={home.record.tab} title={fill(home.record.title)} icon={home.record.icon} intro={home.record.intro} note={fill(home.record.note)} mb="clamp(28px,3.5vw,44px)" />
      </div>

      <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,44px);">
        <div data-reveal="" data-spot="" style="display:grid;grid-template-columns:minmax(0,380px) minmax(0,1fr);align-items:stretch;gap:clamp(24px,4vw,48px);padding-bottom:clamp(8px,1vw,12px);">
          <div style="align-self:start;border:1px solid var(--rule);background:var(--surface);">
            {spot.map((p, i) => (
              <>
                <button type="button" data-spot-row={i} class={'ax-spot-row' + (i === 0 ? ' is-on' : '')} aria-pressed={i === 0 ? 'true' : 'false'} style={i < spot.length - 1 ? undefined : 'border-bottom:0;'}>
                  <span style="font-size:12.5px;font-weight:500;color:var(--brand);font-variant-numeric:tabular-nums;">{p.no}</span>
                  <span style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:18px;letter-spacing:-0.01em;">{p.client}</span>
                  <span style="font-size:12.5px;font-weight:500;color:var(--ink-faint);">{p.year}</span>
                </button>
                <div data-spot-m={i} data-on={i === 0 ? '' : undefined} style="display:none;border-bottom:1px solid var(--rule);padding:0 14px 18px;">
                  <div style="position:relative;height:240px;margin:0 -14px;overflow:hidden;"><img src={p.image} alt={p.client} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /><span style="position:absolute;top:12px;left:12px;padding:5px 9px;background:var(--brand);color:var(--brand-ink);font-weight:500;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;pointer-events:none;">{p.sector}</span></div>
                  <div style="margin-top:14px;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:21px;line-height:1.18;letter-spacing:-0.015em;color:var(--ink);text-wrap:pretty;">{p.title}</div>
                  <div style="margin-top:14px;display:flex;align-items:center;justify-content:space-between;gap:16px;"><div style="border-left:2px solid var(--brand);padding-left:12px;"><div style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:22px;line-height:1;color:var(--brand);">{p.stat}</div><div style="margin-top:4px;font-size:12px;line-height:1.35;color:var(--ink-soft);max-width:20ch;">{p.statLabel}</div></div><a href={p.href} target="_self" aria-label={`Open ${p.client}`} class="ax-fx" style="width:48px;height:48px;flex:none;display:inline-flex;align-items:center;justify-content:center;background:#3B28FF;color:#FFFFFF;"><Icon k="ic113c36" {...ico(20, 1.6)} aria-hidden={undefined} /></a></div>
                </div>
              </>
            ))}
          </div>
          <div style="display:flex;flex-direction:column;gap:22px;min-height:0;">
            <div data-spot-stage="" style="position:relative;flex:1 1 0;min-height:300px;border:1px solid var(--rule);background:var(--surface);overflow:hidden;">
              {spot.map((p, i) => (
                <div class={'ax-sstage' + (i === 0 ? ' is-on' : '')} data-sslide={i}><img src={p.image} alt={p.client} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div>
              ))}
              <span data-s-sector="" style="position:absolute;top:16px;left:16px;padding:6px 10px;background:var(--brand);color:var(--brand-ink);font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;pointer-events:none;">{spot[0].sector}</span>
              <span data-s-no="" aria-hidden="true" style="position:absolute;right:20px;bottom:-22px;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:clamp(110px,12vw,168px);line-height:1;letter-spacing:-0.05em;color:transparent;-webkit-text-stroke:1.5px #FFFFFF;pointer-events:none;">{spot[0].no}</span>
            </div>
            <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(20px,3vw,32px);align-items:end;">
              <div><div data-s-meta="" style="font-weight:500;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--brand);margin-bottom:10px;">{spot[0].client} · {spot[0].year}</div><div data-s-title="" style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(20px,2.1vw,26px);line-height:1.15;letter-spacing:-0.02em;color:var(--ink);text-wrap:balance;min-height:2.3em;">{spot[0].title}</div></div>
              <div style="display:flex;align-items:center;gap:20px;"><div style="border-left:2px solid var(--brand);padding-left:12px;"><div data-s-stat="" style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:26px;line-height:1;color:var(--brand);">{spot[0].stat}</div><div data-s-stat-label="" style="margin-top:4px;font-size:12px;line-height:1.35;color:var(--ink-soft);max-width:16ch;">{spot[0].statLabel}</div></div><a data-s-link="" href={spot[0].href} target="_self" aria-label={`Open ${spot[0].client}`} class="ax-fx" style="width:56px;height:56px;flex:none;display:inline-flex;align-items:center;justify-content:center;background:#3B28FF;color:#FFFFFF;"><Icon k="ic113c36" data-wig="" {...ico(22, 1.6)} aria-hidden={undefined} /></a></div>
            </div>
          </div>
        </div>
        <script type="application/json" id="spot-data" set:html={JSON.stringify(spot)} />

        <div data-reveal="" data-trusted="" style="position:relative;margin-top:clamp(24px,3vw,40px);background:var(--surface);box-shadow:0 0 0 100vmax var(--surface);clip-path:inset(0 -100vmax);padding:clamp(32px,4vw,52px) 0 clamp(32px,4vw,52px);display:flex;flex-direction:column;gap:clamp(28px,3.4vw,36px);">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(22px,3vw,40px);align-items:end;">
            <div style="display:flex;flex-direction:column;gap:14px;">
              <div style="display:inline-flex;align-items:center;gap:9px;font-family:'Outfit',sans-serif;font-weight:500;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--brand);"><Icon k="icaf0bdf" {...ico(14, 1.6)} aria-hidden={undefined} />{home.trusted.eyebrow}</div>
              <h3 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(24px,3vw,34px);line-height:1.1;letter-spacing:-0.022em;color:var(--ink);max-width:24ch;" set:html={rich(home.trusted.title, 'h2')} />
            </div>
            <div data-apx-stats="" style="justify-self:end;display:flex;flex-wrap:nowrap;gap:clamp(20px,3vw,44px);">
              {home.trusted.stats.map((s: any) => (
                <div style="display:flex;align-items:center;gap:18px;"><span aria-hidden="true" style="position:relative;flex:none;width:clamp(92px,8vw,108px);height:clamp(84px,7.4vw,100px);"><span style="position:absolute;right:0;top:0;width:82%;aspect-ratio:1;background:var(--brand-wash);border:1px solid var(--rule);color:var(--brand);display:flex;align-items:center;justify-content:center;font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(40px,3.8vw,50px);line-height:1;letter-spacing:-0.04em;">{s.value}</span><span style={s.iconStyle === 'brand' ? 'position:absolute;left:0;bottom:0;width:38%;aspect-ratio:1;background:var(--brand);color:var(--brand-ink);display:flex;align-items:center;justify-content:center;' : 'position:absolute;left:0;bottom:0;width:38%;aspect-ratio:1;background:var(--paper);border:1px solid var(--rule);color:var(--ink-soft);display:flex;align-items:center;justify-content:center;'}><Icon k={s.icon} {...ico(16, 1.6)} aria-hidden={undefined} /></span></span><span style="font-size:14px;line-height:1.4;color:var(--ink);max-width:16ch;"><span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">{s.srPrefix} </span>{s.text}</span></div>
              ))}
            </div>
          </div>
          <div role="list" aria-label="Commercial and public-sector clients" style="position:relative;width:100vw;margin-left:calc(50% - 50vw);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:clamp(14px,1.6vw,20px) 0;overflow:hidden;">
            <div data-apx-marq="" style="display:flex;width:max-content;animation:apxMarq 48s linear infinite;">
              {[0, 1].map((copy) => home.trusted.clients.map((c: any) => (
                <span style="display:inline-flex;align-items:center;gap:clamp(18px,2.2vw,30px);padding-right:clamp(18px,2.2vw,30px);"><a data-apx-tile="" href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined} aria-label={copy === 0 ? `${c.name}: ${c.external ? 'visit website' : 'read the case study'}` : undefined} tabindex={copy === 1 ? '-1' : undefined} aria-hidden={copy === 1 ? 'true' : undefined} style="display:inline-flex;align-items:center;text-decoration:none;color:var(--ink);"><span data-apx-name="" style="font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(26px,3.2vw,42px);line-height:1;letter-spacing:-0.035em;white-space:nowrap;">{c.name}</span><span data-apx-arrow="" aria-hidden="true"><span><Icon k="ic113c36" {...ico(18, 1.6)} aria-hidden={undefined} /></span></span></a><Icon k="ic0df2f2" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true" style="color:var(--brand);flex:none;" /></span>
              )))}
            </div>
          </div>
          <div data-apx-featured="" style="display:flex;flex-direction:column;gap:14px;"><div style="display:flex;align-items:center;gap:9px;font-family:'Outfit',sans-serif;font-weight:500;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);"><Icon k="ic0df2f2" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true" style="color:var(--brand);flex:none;align-self:center;" />{home.trusted.featuredLabel}</div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:12px;">
            {home.trusted.featured.map((f: any) => (
              <a href={f.href} data-cs-tile="" aria-label={`${f.client}: read the case study`} style="position:relative;display:block;overflow:hidden;height:clamp(260px,26vw,340px);background:var(--surface);border:1px solid var(--rule);text-decoration:none;"><div style="position:absolute;inset:0;"><img src={f.image} alt={f.client} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div><div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(20,17,63,.7) 0%,rgba(20,17,63,0) 35%,rgba(20,17,63,0) 50%,rgba(20,17,63,.86) 100%);pointer-events:none;"></div><div data-cs-cap="" style="position:absolute;left:22px;right:22px;top:20px;color:#FFFFFF;pointer-events:none;"><div style="font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#C9C5F7;margin-bottom:8px;">{f.client}</div><div style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.15;letter-spacing:-0.015em;text-wrap:pretty;max-width:22ch;">{f.title}</div></div><div data-cs-go="" style="position:absolute;left:22px;right:22px;bottom:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;color:#FFFFFF;pointer-events:none;font-family:'Outfit',sans-serif;font-weight:600;font-size:12px;letter-spacing:.09em;text-transform:uppercase;text-shadow:0 1px 8px rgba(20,17,63,.6);">{f.go}<span data-cs-arrow="" style="width:40px;height:40px;flex:none;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.7);color:#FFFFFF;text-shadow:none;"><Icon k="ic113c36" {...ico(18, 1.6)} aria-hidden={undefined} /></span></div></a>
            ))}
          </div></div>
        </div>
      </div>
    </section>

    <section id="constraints" style="border-bottom:1px solid var(--rule);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <HomeHead no="02" tab={home.constraints.tab} title={home.constraints.title} icon={home.constraints.icon} intro={home.constraints.intro} note={home.constraints.note} mb="clamp(32px,4vw,52px)" />
        <div data-cx-grid="" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);">
          {home.constraints.tiles.map((t: any, i: number) => (
            <div data-reveal="" class="cx-tile" style="position:relative;overflow:hidden;min-height:clamp(180px,17vw,220px);background:#14113F;color:#FFFFFF;">
              <div style="position:absolute;inset:0;"><img src={t.image} alt={t.alt} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div>
              <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(14,11,52,.88) 0%,rgba(14,11,52,.55) 42%,rgba(14,11,52,0) 72%);"></div>
              <div aria-hidden="true" data-wash="" style="position:absolute;inset:0;pointer-events:none;background:#3B28FF;opacity:0;transition:opacity .5s ease;"></div>
              <div style="position:relative;z-index:1;pointer-events:none;padding:clamp(24px,3vw,34px);display:flex;flex-direction:column;gap:12px;max-width:440px;">
                <h3 style="margin:0;display:flex;align-items:center;gap:12px;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,24px);line-height:1.15;letter-spacing:-0.015em;color:#FFFFFF;"><Icon k={t.icon} {...ico(22, 1.6)} />{t.title}</h3>
                <p style="margin:0;font-size:16px;line-height:1.6;color:#FFFFFF;">{t.text}</p>
              </div>
              <span data-cx-no="" aria-hidden="true" style="position:absolute;z-index:1;right:20px;bottom:-16px;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:clamp(84px,9vw,120px);line-height:1;letter-spacing:-0.05em;color:transparent;-webkit-text-stroke:1.5px #FFFFFF;pointer-events:none;">{pad(i + 1)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="capability" data-bubbles="b" style="border-bottom:1px solid var(--rule);background:var(--surface);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style="max-width:1240px;margin:0 auto;padding:clamp(36px,4.5vw,60px) clamp(20px,4vw,44px) 0;">
        <HomeHead no="03" tab={home.capability.tab} title={home.capability.title} icon={home.capability.icon} intro={home.capability.intro} note={home.capability.note} mb="clamp(32px,4vw,52px)" h2Size="clamp(28px,3.7vw,46px)" />
      </div>
      <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,44px) clamp(32px,4vw,52px);">
        <div data-reveal="" data-lc="" style="position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;">
          <span aria-hidden="true" data-lc-line="" style="position:absolute;left:28px;right:calc((100% - 72px) / 4 - 28px);top:27px;height:2px;background:repeating-linear-gradient(90deg,var(--rule) 0 8px,transparent 8px 14px);"><span data-lc-fill="" style="position:absolute;inset:0;background:#3B28FF;transform-origin:0 50%;transform:scaleX(0);transition:transform .35s cubic-bezier(.2,.7,.2,1);"></span><span data-lc-end="" class="mt-end" style="display:none;position:absolute;left:-9px;bottom:-10px;width:20px;height:20px;transform:rotate(45deg);border:2px solid var(--brand);"></span></span>
          {home.capability.steps.map((s: any, i: number) => (
            <div data-lc-step="" style="position:relative;display:flex;flex-direction:column;gap:14px;"><span class="lc-ico" style="position:relative;z-index:1;width:56px;height:56px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--brand);"><Icon k={s.icon} {...ico(24, 1.6)} /></span><span style="font-family:'Outfit',sans-serif;font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--brand);">{s.kicker}</span><h3 style={`margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(20px,${i === 0 || i === 2 ? '2vw' : '2vw'},23px);line-height:1.15;letter-spacing:-0.015em;color:var(--ink);`}>{s.title}</h3><p style="margin:0;font-size:15.5px;line-height:1.6;color:var(--ink-soft);">{s.text}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section id="method" data-band="" data-bubbles="" style="border-bottom:1px solid var(--rule);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <HomeHead no="04" tab={home.method.tab} title={home.method.title} icon={home.method.icon} intro={home.method.intro} note={home.method.note} mb="clamp(32px,4vw,52px)" />
        <div data-method-rail="" style="display:flex;flex-direction:column;">
          {home.method.phases.map((p: any) => (
            <div data-reveal="" data-mt-row="" style="display:grid;grid-template-columns:88px minmax(0,1fr) minmax(0,340px);column-gap:clamp(20px,3vw,40px);">
              <div style="position:relative;display:flex;justify-content:center;"><span class="mt-node" style="position:relative;z-index:1;width:64px;height:64px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--brand);"><Icon k={p.icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" /></span><span aria-hidden="true" data-mt-conn="" style="position:absolute;top:64px;bottom:-12px;left:50%;width:2px;margin-left:-1px;background:repeating-linear-gradient(180deg,var(--rule-strong) 0 4px,transparent 4px 9px);opacity:.35;"></span><span aria-hidden="true" data-mt-fill="" style="position:absolute;top:64px;bottom:-12px;left:50%;width:2px;margin-left:-1px;background:#3B28FF;transform-origin:50% 0;transform:scaleY(0);"></span></div>
              <div style="padding:4px 0 clamp(40px,5vw,60px);display:flex;flex-direction:column;gap:14px;min-width:0;">
                <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-family:'Outfit',sans-serif;font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;"><span style="color:var(--brand);">{p.label}</span><span aria-hidden="true" style="width:18px;height:1px;background:var(--rule-strong);"></span><span style="color:var(--ink);">{p.time}</span></div>
                <h3 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(30px,3.6vw,42px);line-height:1.04;letter-spacing:-0.03em;color:var(--ink);">{p.title}</h3>
                <p style="margin:0;font-size:clamp(16px,1.5vw,17px);line-height:1.6;color:var(--ink-soft);max-width:52ch;">{p.text}</p>
                <ul style="margin:6px 0 0;padding:0;list-style:none;display:grid;gap:10px;">{p.bullets.map((b: string) => (<li style="display:flex;gap:10px;align-items:flex-start;font-size:15px;line-height:1.5;color:var(--ink);"><Icon k="ic0df2f2" viewBox="0 0 24 24" width="10" height="10" fill="currentColor" aria-hidden="true" style="flex:none;margin-top:6px;color:var(--brand);" />{b}</li>))}</ul>
              </div>
              <div style="padding:4px 0 clamp(40px,5vw,60px);display:flex;flex-direction:column;gap:12px;">
                <div style="background:var(--brand-wash);padding:22px 24px;display:flex;flex-direction:column;gap:10px;"><span style="display:flex;align-items:center;gap:10px;font-family:'Outfit',sans-serif;font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--brand);"><span style="flex:none;display:inline-flex;align-items:center;color:#3B28FF;"><Icon k="ic40f752" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true" /></span>You leave with</span><span data-mt-leave="" style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:19px;line-height:1.3;color:var(--ink);">{p.leave}</span></div>
                <div style="display:flex;gap:10px;align-items:flex-start;padding:0 4px;font-size:14px;line-height:1.5;color:var(--ink-soft);"><span style="color:var(--brand);display:inline-flex;padding-top:2px;"><Icon k="ic3d3604" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true" /></span><span><strong style="font-weight:500;color:var(--ink);">{p.yourTimeLabel}</strong> {p.yourTime}</span></div>
              </div>
            </div>
          ))}
          <div data-reveal="" style="display:grid;grid-template-columns:88px minmax(0,1fr);column-gap:clamp(20px,3vw,40px);align-items:center;"><div style="display:flex;justify-content:center;"><span class="mt-end" style="position:relative;z-index:1;width:20px;height:20px;transform:rotate(45deg);border:2px solid var(--brand);"></span></div><span style="font-family:'Outfit',sans-serif;font-weight:600;font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink);">{home.method.closing}</span></div>
        </div>
      </div>
    </section>

    <Marquee words={home.marquee.services} label={home.marquee.servicesLabel} reverse />
  </main>
  <script>
    import '../scripts/home';
  </script>
</AuxiliaLayout>
