---
import Icon from '../Icon.astro';
interface Props {
  words: string[];
  label?: string;
  reverse?: boolean;
}
const { words, label, reverse = false } = Astro.props;
const row = "display:flex;align-items:center;white-space:nowrap;font-family:'Outfit',sans-serif;font-weight:500;font-size:clamp(11.5px,1.3vw,13px);letter-spacing:.15em;text-transform:uppercase;color:var(--ink-soft);";
---
<section aria-label={label} style={`border-top:${reverse ? '0' : '1px solid var(--rule)'};border-bottom:1px solid var(--rule);overflow:hidden;background:var(--apx-bg);`}>
  <div class="ldr-marquee" data-marq-rev={reverse ? '' : undefined} style="padding:15px 0;">
    <div style={row}>
      {words.map((w) => (<><span style="padding:0 24px;">{w}</span><Icon k="ic0df2f2" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true" style="color:var(--brand);flex:none;align-self:center;" /></>))}
    </div>
    <div aria-hidden="true" style={row}>
      {words.map((w) => (<><span style="padding:0 24px;">{w}</span><Icon k="ic0df2f2" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true" style="color:var(--brand);flex:none;align-self:center;" /></>))}
    </div>
  </div>
</section>
