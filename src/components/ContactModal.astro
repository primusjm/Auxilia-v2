---
import Icon from './Icon.astro';
const { subject = 'Book a call' } = Astro.props;
---
<div class="ax-ct-scrim" aria-hidden="true" data-ct-close=""></div>
<div class="ax-ct-wrap" role="dialog" aria-modal="true" aria-label="Contact Auxilia" aria-hidden="true" data-ct-dialog="">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px 0 24px;">
    <div style="display:flex;align-items:center;gap:12px;font-weight:500;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--brand);"><span data-ct-env="" aria-hidden="true" style="display:inline-flex;"><Icon k="ic07338b" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" style="overflow:visible;" /></span>Let's talk</div>
    <button type="button" class="ax-fx ax-fx-out ax-x" data-ct-close="" aria-label="Close" style="width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--rule);background:transparent;color:var(--ink);cursor:pointer;"><Icon k="ice82a54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" /></button>
  </div>
  <form data-ct-form="" style="display:flex;flex-direction:column;gap:16px;padding:14px 24px 24px;">
    <h3 style="margin:0 0 4px;font-family:'Bricolage Grotesque','Bricolage Grotesque Fallback',sans-serif;font-weight:500;font-size:21px;line-height:1.2;letter-spacing:-0.015em;color:var(--ink);text-wrap:balance;">Good communication is the bridge between <span style="color:var(--brand);">clarity &amp; confusion.</span></h3>
    <input type="hidden" name="_subject" value={subject} />
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;"><label style="display:flex;flex-direction:column;gap:7px;min-width:0;"><span style="font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);">First name <span style="color:var(--brand);">*</span></span><input name="first_name" type="text" required placeholder="Joshua" autocomplete="given-name" style="width:100%;height:46px;padding:0 14px;border:1px solid var(--rule);border-radius:0;background:var(--surface);color:var(--ink);font-family:'Outfit','Outfit Fallback',sans-serif;font-size:15px;outline:none;transition:border-color .25s ease,box-shadow .25s ease;" class="ax-f35b092" /></label><label style="display:flex;flex-direction:column;gap:7px;min-width:0;"><span style="font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);">Last name</span><input name="last_name" type="text" placeholder="Maithya" autocomplete="family-name" style="width:100%;height:46px;padding:0 14px;border:1px solid var(--rule);border-radius:0;background:var(--surface);color:var(--ink);font-family:'Outfit','Outfit Fallback',sans-serif;font-size:15px;outline:none;transition:border-color .25s ease,box-shadow .25s ease;" class="ax-f35b092" /></label></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;"><label style="display:flex;flex-direction:column;gap:7px;min-width:0;grid-column:1 / -1;"><span style="font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);">E-mail <span style="color:var(--brand);">*</span></span><input name="email" type="email" required placeholder="you@organisation.org" autocomplete="email" style="width:100%;height:46px;padding:0 14px;border:1px solid var(--rule);border-radius:0;background:var(--surface);color:var(--ink);font-family:'Outfit','Outfit Fallback',sans-serif;font-size:15px;outline:none;transition:border-color .25s ease,box-shadow .25s ease;" class="ax-f35b092" /></label><div role="group" aria-label="Phone" style="display:flex;flex-direction:column;gap:7px;min-width:0;grid-column:1 / -1;"><span style="font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);">Phone <span style="color:var(--brand);">*</span></span><span data-cc="" style="position:relative;display:grid;grid-template-columns:auto minmax(0,1fr);"><input type="hidden" name="country_code" value="KE +254" readonly data-cc-value="" /><button type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Country code: Kenya +254" data-cc-btn="" style="height:46px;display:inline-flex;align-items:center;gap:8px;padding:0 12px;border:1px solid var(--rule);border-right:0;border-radius:0;background:var(--surface);color:var(--ink);font-family:'Outfit','Outfit Fallback',sans-serif;font-size:15px;font-variant-numeric:tabular-nums;cursor:pointer;outline:none;transition:border-color .25s ease,background-color .25s ease;" class="ax-hd42d59 ax-f35b092"><span data-cc-iso="" style="font-weight:600;font-size:10.5px;letter-spacing:.12em;color:var(--brand-text);">KE</span><span data-cc-dial="">+254</span><Icon k="ice28539" class="ax-cc-chev" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" /></button><input name="phone" type="tel" required aria-label="Phone number" placeholder="712 345 678" autocomplete="tel-national" inputmode="tel" style="width:100%;min-width:0;height:46px;padding:0 14px;border:1px solid var(--rule);border-radius:0;background:var(--surface);color:var(--ink);font-family:'Outfit','Outfit Fallback',sans-serif;font-size:15px;outline:none;transition:border-color .25s ease,box-shadow .25s ease;" class="ax-f35b092" /><span hidden data-cc-pop="" style="position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:6;display:block;background:var(--paper);border:1px solid var(--brand);box-shadow:0 28px 50px -24px rgba(10,9,32,.55);animation:ccIn .28s cubic-bezier(.2,.7,.2,1);"><span style="display:flex;align-items:center;gap:10px;padding:0 14px;border-bottom:1px solid var(--rule);color:var(--brand);"><Icon k="ic13b615" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" /><input type="text" data-cc-search="" placeholder="Search country or code" aria-label="Search countries" aria-controls="cc-list" style="flex:1;min-width:0;height:44px;border:0;background:transparent;color:var(--ink);font-family:'Outfit','Outfit Fallback',sans-serif;font-size:15px;outline:none;" /><span data-cc-count="" style="font-weight:600;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);font-variant-numeric:tabular-nums;"></span></span><span id="cc-list" role="listbox" data-cc-list="" aria-label="Country codes" style="display:block;max-height:180px;overflow-y:auto;overscroll-behavior:contain;"></span><span hidden data-cc-empty="" style="display:block;padding:18px 14px;font-size:14px;color:var(--ink-soft);">No country matches that.</span></span></span></div></div>
    <label style="display:flex;flex-direction:column;gap:7px;"><span style="font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);">Message <span style="color:var(--brand);">*</span></span><textarea name="message" required rows="4" placeholder="Where does your organisation need to get to?" style="width:100%;padding:12px 14px;border:1px solid var(--rule);border-radius:0;background:var(--surface);color:var(--ink);font-family:'Outfit','Outfit Fallback',sans-serif;font-size:15px;line-height:1.5;resize:vertical;outline:none;transition:border-color .25s ease,box-shadow .25s ease;" class="ax-f35b092"></textarea></label>
    <p role="alert" hidden data-ct-error="" style="margin:0;font-size:14px;line-height:1.45;color:#D93A4A;">That didn't send. Try again, or email <a href="mailto:hello@auxilia.io" style="color:var(--brand);font-weight:600;">hello@auxilia.io</a>.</p>
    <button type="submit" data-ct-submit="" class="ax-btn ax-btn-wide" style="justify-content:center;width:100%;border:0;cursor:pointer;background:#3B28FF;color:#FFFFFF;height:54px;padding:0 24px;"><span class="ax-btn-fill" aria-hidden="true" style="background:#14113F;"></span><span class="ax-btn-ico" aria-hidden="true" data-ct-ico="" style="display:inline-flex;"><Icon k="icsend" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" /></span><span class="ax-btn-t" data-ct-label="">Send message</span></button>
    <span style="display:inline-flex;align-items:center;gap:10px;font-size:14px;line-height:1.45;color:var(--ink-soft);"><span data-ft-pulse="" style="flex:none;width:8px;height:8px;border-radius:50%;background:#3B28FF;animation:ftPulse 2.4s ease-out infinite;"></span>Replies within one working day</span>
  </form>
  <div hidden data-ct-sent="" style="position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:16px;padding:16px 24px 28px;overflow:hidden;">
    <div data-ct-anim="" aria-hidden="true" style="position:relative;width:100%;height:150px;background-color:#3B28FF;background-image:linear-gradient(rgba(255,255,255,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.09) 1px,transparent 1px);background-size:22px 22px;overflow:hidden;opacity:0;animation:ctUp .7s cubic-bezier(.2,.7,.2,1) .2s forwards;"><Icon k="ic5779a4" viewBox="0 0 400 150" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;" /><span style="position:absolute;right:14px;top:10px;color:#FFFFFF;transform:rotate(8deg);"><Icon k="ic49d1a5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="30" height="30" /></span><span style="position:absolute;left:50%;top:52%;width:156px;height:96px;transform:translate(-50%,-50%) rotate(-5deg);background:#FFFFFF;box-shadow:0 24px 40px -18px rgba(10,9,32,.6);display:flex;flex-direction:column;gap:9px;padding:18px 18px 0;box-sizing:border-box;"><span style="display:block;width:46%;height:6px;background:#3B28FF;"></span><span style="display:block;width:88%;height:5px;background:#E4E1FF;"></span><span style="display:block;width:74%;height:5px;background:#E4E1FF;"></span><span style="display:block;width:58%;height:5px;background:#E4E1FF;"></span><span style="position:absolute;right:-14px;top:-14px;width:36px;height:36px;border-radius:50%;background:#14113F;color:#FFFFFF;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 4px #3B28FF;"><Icon k="ic40f752" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" /></span></span></div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:4px;width:100%;"><h3 data-ct-anim="" style="margin:0;font-family:'Bricolage Grotesque','Bricolage Grotesque Fallback',sans-serif;font-weight:500;font-size:clamp(28px,3vw,34px);line-height:1.05;letter-spacing:-0.02em;color:var(--ink);opacity:0;animation:ctUp .6s cubic-bezier(.2,.7,.2,1) 1.5s forwards;">Thank <span style="color:var(--brand);">you.</span></h3><span data-ct-anim="" style="width:48px;height:48px;flex:none;display:block;opacity:0;animation:ctPop .7s cubic-bezier(.2,.7,.2,1) .7s forwards;"><Icon k="ice70e5c" viewBox="0 0 64 64" width="48" height="48" fill="none" aria-hidden="true" /></span></div>
    <p data-ct-anim="" style="margin:0;font-size:15.5px;line-height:1.6;color:var(--ink-soft);max-width:40ch;opacity:0;animation:ctUp .6s cubic-bezier(.2,.7,.2,1) 1.65s forwards;">Your message has been received. We'll be in touch <strong style="font-weight:500;color:var(--ink);">within one working day</strong> to talk about where your organisation needs to get to.</p>
    <div data-ct-anim="" style="display:flex;flex-wrap:wrap;gap:10px;opacity:0;animation:ctUp .6s cubic-bezier(.2,.7,.2,1) 1.8s forwards;"><a class="ax-btn ax-btn-sm" href="/#record" style="background:#3B28FF;color:#FFFFFF;"><span class="ax-btn-fill" aria-hidden="true"></span><span class="ax-btn-t">Explore the record</span><span class="ax-btn-ico" aria-hidden="true" style="display:inline-flex;"><Icon k="ic113c36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" /></span></a></div>
  </div>
</div>
