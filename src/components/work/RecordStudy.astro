---
import Icon from '../Icon.astro';
import SectionHead from './SectionHead.astro';
import RelatedCards from './RelatedCards.astro';
import { rich } from '../../lib/rich';
import { ico } from '../../lib/ico';

interface Props {
  study: any;
  related: { slug: string; no: string; client: string; title: string; image: string }[];
}
const { study: d, related } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const nums: Record<string, string> = {};
(d.sections as string[]).filter((id) => id !== 'next').forEach((id, i) => (nums[id] = pad(i + 1)));

const wrap = 'max-width:1240px;margin:0 auto;padding:clamp(32px,4.2vw,60px) clamp(20px,4vw,44px);';
const plateCap = "font-family:'Outfit',sans-serif;font-weight:500;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint);";
const quoteCardStyle = 'position:relative;overflow:hidden;isolation:isolate;margin:0;padding:clamp(20px,2.4vw,28px);background:var(--surface);border:1px solid var(--rule);border-top:2px solid var(--brand);display:flex;flex-direction:column;justify-content:space-between;gap:22px;';
const lbCaps: string[] = (d.screens?.plates ?? []).map((p: any) => p.caption);
---
<main id="top">
  <div aria-hidden="true" data-mark-top="" style="position:absolute;left:-90px;top:-150px;width:347px;height:600px;pointer-events:none;z-index:0;opacity:.07;transform-origin:50% 70%;transition:transform .8s cubic-bezier(.2,.7,.2,1);"><div style="position:absolute;inset:0;background:var(--brand);-webkit-mask:url(/assets/mark-helmet.png) center/contain no-repeat;mask:url(/assets/mark-helmet.png) center/contain no-repeat;"></div><div style="position:absolute;inset:0;background:var(--brand);-webkit-mask:url(/assets/mark-plume.png) center/contain no-repeat;mask:url(/assets/mark-plume.png) center/contain no-repeat;"></div></div>
  <a href="/" aria-label="Auxilia home" style="position:absolute;z-index:3;top:28px;left:clamp(20px,4vw,44px);display:inline-flex;align-items:center;text-decoration:none;"><Icon k="icaa80bf" data-ax-logo="" viewBox="140 60 4290 1410" width="132" height="43" aria-hidden="true" style="display:block;overflow:visible;" /></a>

  <section data-bubbles="" data-hero="" style="z-index:2;">
    <img src={d.cardImage} alt="" aria-hidden="true" style="position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:.42;filter:grayscale(.6) contrast(1.05);pointer-events:none;" />
    <div aria-hidden="true" style="position:absolute;z-index:-2;inset:0;pointer-events:none;background:linear-gradient(90deg,color-mix(in srgb,var(--paper) 94%,transparent) 0%,color-mix(in srgb,var(--paper) 78%,transparent) 50%,color-mix(in srgb,var(--paper) 25%,transparent) 100%),linear-gradient(0deg,color-mix(in srgb,var(--paper) 90%,transparent) 0%,transparent 35%);"></div>
    <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
    <div style="max-width:1240px;margin:0 auto;padding:calc(clamp(44px,6vw,72px) + 84px) clamp(20px,4vw,44px) 0;">
      <div data-reveal="" style="font-family:'Outfit',sans-serif;font-weight:500;font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--brand);margin-bottom:clamp(28px,4vw,44px);">{d.hero.eyebrow}</div>
      <h1 data-reveal="" style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(34px,5.4vw,70px);line-height:1.04;letter-spacing:-0.024em;color:var(--ink);max-width:none;text-wrap:balance;" set:html={rich(d.hero.title, 'h1')} />
      <p data-reveal="" style="margin:clamp(22px,3vw,32px) 0 0;font-family:'Bricolage Grotesque',sans-serif;font-weight:400;font-size:clamp(20px,2.6vw,30px);line-height:1.32;letter-spacing:-0.012em;color:var(--ink-soft);max-width:36ch;" set:html={rich(d.hero.lead)} />
    </div>
    <div data-reveal="" style="position:relative;z-index:1;margin-top:clamp(30px,4vw,48px);background:var(--surface);border-top:2px solid var(--brand);border-bottom:1px solid var(--rule);">
      <div data-facts="" style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,44px);box-sizing:border-box;display:grid;gap:0;">
        {d.hero.facts.map((f: any) => (
          <div>
            <div style="font-family:'Outfit',sans-serif;font-weight:500;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:8px;display:flex;align-items:center;gap:8px;"><span data-fact-ico="" aria-hidden="true" style="color:var(--brand);display:inline-flex;flex-shrink:0;"><Icon k={f.icon} {...ico(15, 1.6)} /></span>{f.label}</div>
            <div style="font-size:15.5px;line-height:1.45;color:var(--ink);" set:html={rich(f.value)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {d.mandate && (
    <section id="mandate" style="background:var(--surface);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <SectionHead no={nums.mandate} tab={d.mandate.tab} title={d.mandate.title} icon={d.mandate.icon} intro={d.mandate.intro} note={d.mandate.note} mb="0" />
        <div data-three="" data-reveal="" style="display:grid;gap:clamp(22px,3vw,44px);margin-top:clamp(32px,4vw,52px);">
          {d.mandate.cards.map((c: any) => (
            <div data-mcard="" style="background:var(--paper);border:1px solid var(--rule);border-top:2px solid var(--brand);padding:clamp(22px,2.4vw,30px);display:flex;flex-direction:column;gap:12px;transition:transform .4s cubic-bezier(.2,.7,.2,1),box-shadow .4s ease;" class="ax-heb9b91"><span data-draw-ico="" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;margin-bottom:4px;background:var(--brand-wash);color:var(--brand);"><Icon k={c.icon} {...ico(24, 1.6)} /></span><div style="font-family:'Outfit',sans-serif;font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--brand);">{c.label}</div><p style="margin:0;font-size:clamp(16px,1.6vw,17px);line-height:1.65;color:var(--ink-soft);text-wrap:pretty;" set:html={rich(c.text)} /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.found && (
    <section id="found" data-band="" data-bubbles="b" style="border-bottom:1px solid var(--rule);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <SectionHead no={nums.found} tab={d.found.tab} title={d.found.title} icon={d.found.icon} intro={d.found.intro} note={d.found.note} mb="clamp(30px,4vw,50px)" />
        <div data-found-split="" style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(24px,5vw,64px);align-items:stretch;">
          <div data-reveal="" style="display:flex;flex-direction:column;"><div style="position:relative;flex:1;min-height:clamp(300px,38vw,560px);border:1px solid var(--rule);" data-plate=""><img src={d.found.image.src} alt={d.found.image.alt} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div></div>
          <div style="display:flex;flex-direction:column;justify-content:space-between;gap:clamp(24px,3vw,36px);">
            {d.found.people.map((p: any) => (
              <div data-reveal="" style="border-top:1px solid var(--brand);padding-top:18px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;"><span data-draw-ico="" style="display:inline-flex;align-items:center;justify-content:center;flex:none;width:40px;height:40px;background:var(--brand-wash);color:var(--brand);"><Icon k={p.icon} {...ico(22, 1.6)} /></span><h3 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(19px,2vw,23px);line-height:1.2;letter-spacing:-0.014em;color:var(--ink);">{p.title}</h3></div>
                <p style="margin:0;font-size:15.5px;line-height:1.6;color:var(--ink-soft);" set:html={rich(p.text)} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {d.decisions && (
    <section id="decisions" data-bubbles="" style="border-bottom:1px solid var(--rule);background:var(--surface);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <SectionHead no={nums.decisions} tab={d.decisions.tab} title={d.decisions.title} icon={d.decisions.icon} intro={d.decisions.intro} note={d.decisions.note} mb="clamp(24px,3vw,40px)" />
        <div style="border-top:2px solid var(--rule-strong);">
          {d.decisions.items.map((it: any, n: number) => (
            <div data-reveal="" data-two="" data-tile-row="" style="display:grid;gap:clamp(14px,3vw,44px);padding:24px 0;border-bottom:1px solid var(--rule);">
              <div>
                <div style="font-family:'Outfit',sans-serif;font-weight:500;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--brand);margin-bottom:10px;display:flex;align-items:center;gap:10px;"><span data-dec-ico="" data-draw-ico="" aria-hidden="true" style="display:inline-flex;color:var(--brand);"><Icon k={it.icon} {...ico(15, 1.7)} /></span>Decision {pad(n + 1)}</div>
                <h3 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(20px,2.3vw,26px);line-height:1.2;letter-spacing:-0.014em;color:var(--ink);max-width:26ch;">{it.title}</h3>
              </div>
              <div style="display:flex;flex-direction:column;gap:12px;">
                <p style="margin:0;font-size:15.5px;line-height:1.62;color:var(--ink-soft);" set:html={rich(it.text)} />
                <p style="margin:0;font-size:14.5px;line-height:1.55;color:var(--ink);"><span style="font-family:'Outfit',sans-serif;font-weight:600;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--brand);">{it.onSiteLabel} </span><Fragment set:html={rich(it.onSite)} /></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.logo && (
    <section id="logo" data-band="">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <SectionHead no={nums.logo} tab={d.logo.tab} title={d.logo.title} icon={d.logo.icon} intro={d.logo.intro} note={d.logo.note} mb="clamp(28px,3.6vw,46px)" />
        <div data-plates="" data-reveal="" style="display:grid;gap:clamp(12px,1.6vw,20px);">
          {d.logo.beforeAfter.map((b: any) => (
            <div>
              <div style="position:relative;height:clamp(200px,26vw,340px);border:1px solid var(--rule);background:var(--paper);" data-plate="">{b.src ? <img src={b.src} alt={b.alt} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /> : null}</div>
              <div style={`margin-top:10px;${plateCap}`} set:html={rich(b.caption)} />
            </div>
          ))}
        </div>
        <div data-three="" data-reveal="" style="display:grid;gap:clamp(22px,3vw,44px);margin-top:clamp(32px,4vw,52px);">
          {d.logo.cards.map((c: any) => (
            <div style="border-top:1px solid var(--brand);padding-top:18px;display:flex;flex-direction:column;gap:12px;"><div style="font-family:'Outfit',sans-serif;font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--brand);">{c.label}</div><p style="margin:0;font-size:clamp(16px,1.6vw,17px);line-height:1.65;color:var(--ink-soft);text-wrap:pretty;" set:html={rich(c.text)} /></div>
          ))}
        </div>
        <div data-reveal="" style="margin-top:clamp(32px,4vw,56px);">
          <div style="position:relative;height:clamp(240px,34vw,460px);border:1px solid var(--rule);" data-plate="">{d.logo.system.src ? <img src={d.logo.system.src} alt={d.logo.system.alt} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /> : null}</div>
          <div style={`margin-top:10px;${plateCap}`} set:html={rich(d.logo.system.caption)} />
        </div>
      </div>
    </section>
  )}

  {d.screens && (
    <section id="screens">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <SectionHead no={nums.screens} tab={d.screens.tab} title={d.screens.title} icon={d.screens.icon} intro={d.screens.intro} link={d.screens.link} mb="clamp(26px,3.4vw,44px)" />
        <div data-reveal="" style="position:relative;height:clamp(240px,38vw,520px);border:1px solid var(--rule);" data-plate="" data-lb="0" data-lb-plate="The screens" data-lb-cap={lbCaps[0]}><img src={d.screens.plates[0].src} alt={d.screens.plates[0].alt} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div>
        <div data-reveal="" style={`margin-top:10px;margin-bottom:clamp(14px,2vw,22px);${plateCap}`}>{lbCaps[0]}</div>
        <div data-plates="" data-reveal="" style="display:grid;gap:clamp(12px,1.6vw,20px);">
          {d.screens.plates.slice(1).map((p: any, n: number) => (
            <div>
              <div style="position:relative;height:clamp(200px,26vw,340px);border:1px solid var(--rule);" data-plate="" data-lb={String(n + 1)} data-lb-plate="The screens" data-lb-cap={lbCaps[n + 1]}><img src={p.src} alt={p.alt} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div>
              <div style={`margin-top:10px;${plateCap}`}>{lbCaps[n + 1]}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.build && (
    <section id="build" style="border-bottom:1px solid var(--rule);background:var(--surface);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <SectionHead no={nums.build} tab={d.build.tab} title={d.build.title} icon={d.build.icon} intro={d.build.intro} note={d.build.note} mb="clamp(28px,3.6vw,46px)" />
        <div data-reveal="" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:clamp(10px,1.2vw,14px);">
          {d.build.cards.map((c: any) => (
            <div data-bcard="" style="display:flex;flex-direction:column;gap:14px;padding:clamp(18px,2vw,24px);border:1px solid var(--rule);background:var(--paper);"><span aria-hidden="true" style="color:var(--brand);display:inline-flex;"><Icon k={c.icon} {...ico(22, 1.6)} /></span><span style="font-family:'Outfit',sans-serif;font-weight:600;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-faint);">{c.label}</span><p style="margin:0;font-size:14.5px;line-height:1.5;color:var(--ink);text-wrap:pretty;" set:html={rich(c.text)} /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.results && (
    <section id="results" data-band="" style="border-bottom:1px solid var(--rule);">
      <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
      <div style={wrap}>
        <SectionHead no={nums.results} tab={d.results.tab} title={d.results.title} icon={d.results.icon} intro={d.results.intro} note={d.results.note} mb="clamp(28px,3.6vw,46px)" />
        <div data-three="" data-reveal="" style="display:grid;gap:clamp(22px,3vw,44px);">
          {d.results.stats.map((s: any) => (
            <div style="border-top:1px solid var(--brand);padding-top:16px;">
              <div style="font-family:'Bricolage Grotesque',sans-serif;font-weight:300;font-size:clamp(40px,5vw,58px);line-height:1;letter-spacing:-0.02em;color:var(--brand);">{s.value}</div>
              <p style="margin:10px 0 0;font-size:15px;line-height:1.55;color:var(--ink);" set:html={rich(s.text)} />
            </div>
          ))}
        </div>
        {d.results.quote && (
          <figure data-reveal="" style="position:relative;overflow:hidden;isolation:isolate;margin:clamp(36px,4.5vw,60px) 0 0;display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(18px,2.6vw,36px);align-items:start;padding:clamp(24px,3vw,40px);background:var(--surface);border:1px solid var(--rule);">
            <span data-q-bg="" aria-hidden="true" style="position:absolute;z-index:-1;right:-24px;bottom:-60px;color:var(--brand);opacity:.07;display:block;pointer-events:none;"><Icon k="ic95724a" viewBox="0 0 24 24" fill="currentColor" stroke="none" width="320" height="320" aria-hidden="true" /></span>
            <span data-q-ico="" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:clamp(48px,5vw,64px);height:clamp(48px,5vw,64px);background:var(--brand);color:var(--brand-ink);"><Icon k="ic95724a" viewBox="0 0 24 24" fill="currentColor" stroke="none" width="28" height="28" aria-hidden="true" /></span><div style="display:grid;gap:clamp(20px,2.4vw,30px);">
              <blockquote style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:clamp(19px,2.2vw,27px);line-height:1.28;letter-spacing:-0.016em;color:var(--ink);text-wrap:pretty;max-width:56ch;" set:html={rich(d.results.quote.text)} />
              <figcaption style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;border-top:1px solid var(--rule);padding-top:clamp(14px,1.6vw,20px);">
                <span aria-hidden="true" style={`display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;flex:none;background:var(--brand-wash);color:var(--brand);${d.results.quote.avatar.initials ? "font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:16px;letter-spacing:.02em;" : ''}`}>{d.results.quote.avatar.icon ? <Icon k={d.results.quote.avatar.icon} {...ico(20, 1.6)} /> : d.results.quote.avatar.initials}</span>
                <span style="display:grid;gap:3px;">
                  <span style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:17px;letter-spacing:-0.01em;color:var(--ink);">{d.results.quote.name}</span>
                  <span style="font-size:14px;color:var(--ink-soft);">{d.results.quote.role}</span>
                </span>
                <span style="margin-left:auto;font-family:'Outfit',sans-serif;font-weight:500;font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--brand);border:1px solid var(--brand);padding:7px 10px;">{d.results.quote.tag}</span>
              </figcaption>
            </div>
          </figure>
        )}
        {d.results.quotes && d.results.quotes.length > 0 && (
          <div data-reveal="" data-three={d.results.quotes.length === 3 ? '' : undefined} style={d.results.quotes.length === 3 ? 'display:grid;gap:clamp(22px,3vw,44px);margin-top:clamp(28px,3.6vw,48px);' : 'display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:clamp(22px,3vw,44px);margin-top:clamp(28px,3.6vw,48px);'}>
            {d.results.quotes.map((q: any) => (
              <figure data-tq="" style={quoteCardStyle}><span data-tq-bg="" aria-hidden="true" style="position:absolute;z-index:-1;right:-14px;top:-18px;color:var(--brand);opacity:.06;pointer-events:none;"><Icon k="ic95724a" viewBox="0 0 24 24" fill="currentColor" stroke="none" width="140" height="140" aria-hidden="true" /></span><div style="display:flex;flex-direction:column;gap:16px;"><span data-tq-ico="" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;background:var(--brand-wash);color:var(--brand);"><Icon k="ic95724a" viewBox="0 0 24 24" fill="currentColor" stroke="none" width="18" height="18" aria-hidden="true" /></span><blockquote style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:400;font-size:clamp(15px,1.3vw,16.5px);line-height:1.5;letter-spacing:-0.01em;color:var(--ink);text-wrap:pretty;" set:html={rich(q.text)} /></div><figcaption style="display:flex;align-items:center;gap:12px;border-top:1px solid var(--rule);padding-top:16px;"><span aria-hidden="true" style={`display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;flex:none;background:var(--brand);color:var(--brand-ink);${q.avatar.initials ? "font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:14px;letter-spacing:.02em;" : ''}`}>{q.avatar.icon ? <Icon k={q.avatar.icon} {...ico(18, 1.6)} /> : q.avatar.initials}</span><span style="display:grid;gap:2px;min-width:0;"><span style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:16px;color:var(--ink);">{q.name}</span><span style="font-size:13.5px;line-height:1.4;color:var(--ink-soft);">{q.role}</span></span></figcaption></figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <RelatedCards items={related} />
</main>
