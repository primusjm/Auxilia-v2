---
import Icon from '../Icon.astro';
interface Props {
  items: { slug: string; no: string; client: string; title: string; image: string }[];
  /** The label link at the right. Appendix studies point at the work list, record studies at #record. */
  label?: string;
}
const { items } = Astro.props;
---
<section id="next" style="border-bottom:1px solid var(--rule);background:var(--surface);">
  <div data-grid="" aria-hidden="true"><span data-grid-rule=""></span></div>
  <div style="max-width:1240px;margin:0 auto;padding:clamp(36px,4.5vw,64px) clamp(20px,4vw,44px);">
    <div data-reveal="" style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:18px;font-family:'Outfit','Outfit Fallback',sans-serif;font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;"><span style="display:inline-flex;align-items:center;gap:14px;font-size:11.5px;color:var(--brand);"><Icon k="ice496b2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true" />Related</span><a href="/#record" style="color:var(--brand);text-decoration:none;" class="ax-h9bcc06">All missions <Icon k="ic113c36" data-wig="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true" style="vertical-align:-2px;" /></a></div>
    <div data-reveal="" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:12px;">
      {items.map((r) => (
        <a href={`/work/${r.slug}`} data-cs-tile="" style="position:relative;display:block;overflow:hidden;height:clamp(190px,19vw,250px);background:var(--surface);border:1px solid var(--rule);text-decoration:none;">
          <div style="position:absolute;inset:0;"><img src={r.image} alt={r.client} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /></div>
          <div style="position:absolute;inset:0;background:linear-gradient(0deg,rgba(20,17,63,0) 40%,rgba(20,17,63,.86) 100%);pointer-events:none;"></div>
          <span aria-hidden="true" style="position:absolute;right:16px;bottom:-14px;font-family:'Bricolage Grotesque','Bricolage Grotesque Fallback',sans-serif;font-weight:700;font-size:clamp(72px,7vw,100px);line-height:1;letter-spacing:-0.05em;color:transparent;-webkit-text-stroke:1.5px #FFFFFF;pointer-events:none;">{r.no}</span>
          <div data-cs-cap="" style="position:absolute;left:22px;right:clamp(110px,12vw,150px);top:20px;color:#FFFFFF;pointer-events:none;">
            <div style="font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#C9C5F7;margin-bottom:8px;">{r.client}</div>
            <div style="font-family:'Bricolage Grotesque','Bricolage Grotesque Fallback',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.15;letter-spacing:-0.015em;text-wrap:pretty;max-width:22ch;">{r.title}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
