---
import Icon from '../Icon.astro';
import { rich } from '../../lib/rich';

interface Props {
  no: string;
  tab: string;
  title: string;
  icon: string;
  intro: string;
  note?: string;
  link?: { href: string; text: string; underline?: boolean };
  /** Bottom margin, as the design sets it per section. */
  mb: string;
}
const { no, tab, title, icon, intro, note, link, mb } = Astro.props;
const linkStyle =
  "align-self:flex-start;display:inline-flex;align-items:center;gap:6px;font-family:'Outfit',sans-serif;font-weight:600;font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--brand);" +
  (link?.underline ? 'text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1.5px;' : 'text-decoration:none;');
---
<div data-reveal="" style={`display:flex;flex-direction:column;margin-bottom:${mb};`}><div style="display:flex;align-items:flex-end;border-bottom:1px solid var(--brand);"><span style="display:inline-flex;align-items:center;gap:12px;background:var(--brand-wash);color:var(--brand);padding:12px 18px;border-bottom:2px solid var(--brand);margin-bottom:-1px;font-family:'Outfit',sans-serif;font-weight:500;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;"><span style="font-family:'Bricolage Grotesque',sans-serif;font-weight:500;font-size:15px;letter-spacing:0;">{no}</span>{tab}</span></div><div data-sh-split="" style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(24px,5vw,64px);align-items:end;padding-top:clamp(24px,3vw,36px);"><h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:400;font-size:clamp(28px,4vw,46px);line-height:1.08;letter-spacing:-0.02em;color:var(--ink);max-width:22ch;text-wrap:pretty;" set:html={rich(title, 'h2')} /><div style="display:flex;align-items:stretch;gap:20px;"><span aria-hidden="true" style="flex:none;align-self:flex-start;width:56px;height:56px;display:inline-flex;align-items:center;justify-content:center;background:var(--brand-wash);color:var(--brand);"><Icon k={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="26" height="26" aria-hidden="true" /></span><div style="display:flex;flex-direction:column;gap:14px;border-left:1px solid var(--brand);padding-left:24px;"><p style="margin:0;font-size:clamp(16px,1.5vw,17px);line-height:1.6;color:var(--ink-soft);text-wrap:pretty;" set:html={rich(intro)} />{link ? <a href={link.href} target="_blank" rel="noopener" data-live-link="" style={linkStyle} class="ax-h9bcc06">{link.text} <Icon k="ic113c36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true" /></a> : <span style="font-family:'Outfit',sans-serif;font-weight:600;font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink);">{note}</span>}</div></div></div></div>
